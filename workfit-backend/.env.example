# 이 파일을 복사해서 .env로 저장 후 실제 값을 채워넣으세요.
# .env는 절대 git에 커밋하지 마세요 (.gitignore에 추가 권장)

# ==================== 데이터베이스 ====================
# PostgreSQL 연결 문자열 (로컬 개발 예시)
# 형식: postgresql+psycopg2://사용자명:비밀번호@호스트:포트/데이터베이스명?client_encoding=utf8
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/workfit?client_encoding=utf8

# ==================== CORS 설정 ====================
# 프론트엔드 주소 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ==================== 환경 설정 ====================
# development (개발) 또는 production (배포)
ENVIRONMENT=development

# ==================== AI/API 키 ====================
# Google Gemini API 키 (워크챗용 AI 상담)
# 발급처: https://ai.google.dev/
# 없으면 더미 답변으로 대체
GOOGLE_API_KEY=your_google_api_key_here

# BigKinds API 인증키 (뉴스 수집 - 현재 미구현)
# 발급처: https://www.bigkinds.or.kr/
BIGKINDS_ACCESS_KEY=
