# 이 파일을 복사해서 .env로 저장 후 실제 값을 채워넣으세요.
# .env는 절대 git에 커밋하지 마세요 (.gitignore에 추가 권장)

# 데이터베이스 연결 (PostgreSQL)
# 형식: postgresql://사용자:비밀번호@호스트:포트/데이터베이스명
DATABASE_URL=postgresql://postgres:password@localhost:5432/workfit_db

# Claude API 키 (없으면 워크챗은 더미 답변으로 동작함 - 개발 중엔 없어도 됨)
ANTHROPIC_API_KEY=

# 빅카인즈 API 인증키 (승인되면 채워넣기)
BIGKINDS_ACCESS_KEY=

# 온통청년 API 인증키 (승인되면 채워넣기)
YOUTHCENTER_API_KEY=
